# MindSync dark theme - modern card UI

QWidget {
    background-color: #0F1115;
    color: #E8ECF1;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

QMainWindow::separator { background: #0F1115; }

/* ---------- Cards ---------- */
QGroupBox {
    background-color: #171B22;
    border: 1px solid #2A3140;
    border-radius: 14px;
    margin-top: 14px;
    padding: 14px;
    font-weight: 600;
    color: #E8ECF1;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    top: 2px;
    padding: 0 6px;
    color: #9AA3B2;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

/* ---------- Inputs ---------- */
QLineEdit, QDoubleSpinBox {
    background-color: #12151B;
    border: 1px solid #2A3140;
    border-radius: 8px;
    padding: 7px 10px;
    color: #E8ECF1;
    selection-background-color: #4F7CFF;
}
QLineEdit:focus, QDoubleSpinBox:focus { border: 1px solid #4F7CFF; }
QLineEdit::placeholder { color: #5C6575; }

/* ---------- Buttons ---------- */
QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4F7CFF, stop:1 #7C5CFF);
    border: none;
    border-radius: 9px;
    padding: 9px 14px;
    color: white;
    font-weight: 700;
}
QPushButton:hover { background-color: #5F8AFF; }
QPushButton:pressed { background-color: #3E63CC; }
QPushButton#ghost {
    background-color: #1D232E;
    border: 1px solid #2A3140;
    color: #E8ECF1;
    font-weight: 600;
}
QPushButton#ghost:hover { background-color: #242C3A; }

/* ---------- Table ---------- */
QTableWidget {
    background-color: #171B22;
    alternate-background-color: #161A21;
    gridline-color: #232A38;
    border: 1px solid #2A3140;
    border-radius: 12px;
    selection-background-color: rgba(79,124,255,0.28);
    selection-color: #FFFFFF;
    outline: 0;
}
QTableWidget::item { padding: 6px; border: none; }
QHeaderView::section {
    background-color: #1D232E;
    color: #9AA3B2;
    border: none;
    border-bottom: 1px solid #2A3140;
    padding: 8px 6px;
    font-weight: 700;
    font-size: 12px;
}
QTableCornerButton::section { background: #1D232E; border: none; }

/* ---------- Progress bars ---------- */
QProgressBar {
    background-color: #12151B;
    border: 1px solid #2A3140;
    border-radius: 7px;
    text-align: center;
    color: #E8ECF1;
    height: 18px;
}
QProgressBar::chunk { border-radius: 6px; }

/* ---------- Scrollbars ---------- */
QScrollBar:vertical {
    background: transparent; width: 10px; margin: 2px;
}
QScrollBar::handle:vertical {
    background: #2A3140; border-radius: 5px; min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #3A4358; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: transparent; height: 10px; margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #2A3140; border-radius: 5px; min-width: 30px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---------- Splitter ---------- */
QSplitter::handle { background: #0F1115; width: 8px; }

/* ---------- Message boxes ---------- */
QMessageBox { background-color: #171B22; }

